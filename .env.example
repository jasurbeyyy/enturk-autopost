# Bu faylni .env nomi bilan nusxalang va to'ldiring:  cp .env.example .env
# .env faylini hech kimga yubormang va GitHub'ga yuklamang!

# @BotFather bergan token
TELEGRAM_BOT_TOKEN=

# Kanal: @EnTurk_CSR yoki -100... ko'rinishidagi ID
CHANNEL_ID=@EnTurk_CSR

# Postlarni tasdiqlaydigan admin(lar)ning Telegram ID raqami (botga /start yozsangiz ko'rsatadi)
# Bir nechta bo'lsa vergul bilan. Birinchi ID'ga post ko'rsatiladi.
ADMIN_IDS=

# Google AI Studio: https://aistudio.google.com/apikey
GEMINI_API_KEY=

# ElevenLabs: Profile → API Keys
ELEVENLABS_API_KEY=

# 1 = sinov rejimi (Gemini/ElevenLabs chaqirilmaydi, pul sarflanmaydi)
MOCK=0
